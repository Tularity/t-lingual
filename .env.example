TLINGUAL_ENV=development
TLINGUAL_LISTEN_ADDR=127.0.0.1:8088
TLINGUAL_PUBLIC_URL=http://localhost:8088
TLINGUAL_RP_DISPLAY_NAME=t-lingual
# Production requires the exact immediate HTTPS reverse-proxy peer network(s).
# The proxy must append or overwrite X-Forwarded-For with the connecting client.
TLINGUAL_TRUSTED_PROXY_CIDRS=
TLINGUAL_DATA_PATH=./data/t-lingual.db
TLINGUAL_MASTER_KEY_PATH=./data/master.key
TLINGUAL_ADMIN_SOCKET=./data/admin.sock
TLINGUAL_WEB_ROOT=./frontend/dist

# Remote inference services. t-lingual never runs a model itself.
TLINGUAL_ASR_BASE_URL=http://localhost:8300
TLINGUAL_ASR_API_KEY=
TLINGUAL_TRANSLATOR_BASE_URL=http://localhost:8080
TLINGUAL_TRANSLATOR_API_KEY=
# Production requires HTTPS provider URLs unless this explicit private-network
# exception is enabled. Development mode permits HTTP without it.
TLINGUAL_ALLOW_INSECURE_PROVIDERS=false
